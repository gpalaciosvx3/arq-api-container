{
  "name": "arq-api-container",
  "version": "1.0.0",
  "description": "Arquetipo de API contenerizada — NestJS + Fastify + Clean Architecture sobre @gpkit/*",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "arch:check": "depcruise --config .dependency-cruiser.js src",
    "spec": "redocly bundle specs/openapi.yaml -o local-docs/openapi.yaml",
    "lint": "npm run lint:code && npm run lint:spec",
    "lint:code": "eslint .",
    "lint:spec": "redocly lint specs/openapi.yaml",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@gpkit/core": "^1.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "fastify": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@gpkit/arch-rules": "^1.0.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/testing": "^11.1.28",
    "@redocly/cli": "^2.51.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": "prettier --write"
  }
}
